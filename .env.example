# Copy to .env and fill in. Never commit .env.

# local | prod
PIPELINE_ENV=local

# Local DuckDB file used when PIPELINE_ENV=local
PIPELINE_DUCKDB_PATH=data/warehouse.duckdb

# MotherDuck database and token, used when PIPELINE_ENV=prod
PIPELINE_MOTHERDUCK_DATABASE=czech_energy
MOTHERDUCK_TOKEN=

# Only if your home directory path is not ASCII (MotherDuck cannot install there), e.g.
# PIPELINE_DUCKDB_EXTENSION_DIRECTORY=C:/Projects/czech-energy-pipeline/.duckdb/extensions
